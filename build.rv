module build;

#import "src/build_inc.rv"

_ :: #import io;
_ :: #import misc;
_ :: #import compile;
_ :: #import "collections.rv";
#import os;
#import ast;
#import array;
#import mem;
#import str;

#run {
	ci := build();
	add_build_target("demo", ci);
}

after_link :: fn(objs: []string) {
	cmd := build_link_command(objs);
	code := system(cmd.data);
	if code != 0 {
		println("BUILD ERROR %!", code);
	}
	delete_objs(objs);

	os.copy_file("bin/module.wasm", "demo/module.wasm");
	os.copy_file("index.html", "demo/index.html");
	os.copy_file("wasm.js", "demo/wasm.js");

	println("Done!");
}
