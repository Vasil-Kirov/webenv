module util;

_ :: #import misc;
_ :: #import wasm;
_ :: #import util;
#import os;
#import renderer;
#import array;

AssetType :: enum: u8 {
	None,
	Image,
}

LoadingState :: enum: u8 {
	NotLoaded,
	StartedLoading,
	Loaded,
	FailedToLoad,
}

ImageAsset :: struct {
	t: AssetType,
	state: LoadingState,
	width: u32,
	height: u32,
	texture: u32,
}

Asset :: union {
	base: struct {
		t: AssetType,
		state: LoadingState,
	},
	img: ImageAsset,
}

AssetID :: int;

AssetManager :: struct {
	assets: []Asset,
}

create_asset_manager :: fn() -> AssetManager {
	return .{
		assets = array.create(Asset, &heap),
	};
}

get_asset :: fn(manager: *AssetManager, id: AssetID) -> (*Asset, bool) {
	a := &manager.assets[id];
	ok := a.base.state == .Loaded;
	return a, ok;
}

get_asset_o :: fn(manager: *AssetManager, id: AssetID) -> Optional<*Asset> {
	a, ok := get_asset(manager, id);
	if !ok
		return none(*Asset);
	return wrap(a);
}

get_assets :: fn(manager: *AssetManager, ids: []AssetID) -> Optional<[]*Asset> {
	assets := make_slice(temp_arena, ids.count, *Asset);
	for i, id in ids {
		asset, ok := get_asset(manager, id);
		if !ok
			return none([]*Asset);
		assets[i] = asset;
	}
	return wrap(assets);
}

load_img :: fn(manager: *AssetManager, name: string) -> (AssetID, bool) {
	//img := &manager.assets[id as uint].img;
	img: ImageAsset;
	img.t = .Image;
	fd := os.open(name.data, len(name) as u32);
	if fd == -1
		return 0, false;

	img.texture = renderer.file_img_upload(fd);
	img.width   = renderer.file_get_width(fd);
	img.height  = renderer.file_get_height(fd);
	img.state   = .Loaded;

	id := len(manager.assets);
	array.add(&manager.assets, Asset { img = img });
	return id, true;
}

load_img_on_success :: fn(_fname: *u8, img: *ImageAsset, texture: u32, width: u32, height: u32) #foreign #tag="wexport" {
	img.texture = texture;
	img.width   = width;
	img.height  = height;
	img.state   = .Loaded;
	//print("Loaded: %s", fname);
}

load_img_on_error :: fn(fname: *u8, img: *ImageAsset) #foreign #tag="wexport" {
	img.state = .FailedToLoad;
	print("Failed: %s", fname);
}

