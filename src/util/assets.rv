module util;

_ :: #import misc;
_ :: #import wasm;
_ :: #import util;

AssetType :: enum: u8 {
	None,
	Image,
}

LoadingState :: enum: u8 {
	NotLoaded,
	StartedLoading,
	Loaded,
	FailedToLoad,
}

ImageAsset :: struct {
	t: AssetType,
	state: LoadingState,
	width: u32,
	height: u32,
	texture: u32,
}

Asset :: union {
	base: struct {
		t: AssetType,
		state: LoadingState,
	},
	img: ImageAsset,
}

AssetManager :: struct {
	assets: [512]Asset,
}

create_asset_manager :: fn() -> AssetManager {
	return .{
	};
}

get_asset :: fn(manager: *AssetManager, id: AssetID) -> (*Asset, bool) {
	a := &manager.assets[id as uint];
	ok := a.base.state == .Loaded;
	return a, ok;
}

get_asset_o :: fn(manager: *AssetManager, id: AssetID) -> Optional<*Asset> {
	a, ok := get_asset(manager, id);
	if !ok
		return none(*Asset);
	return wrap(a);
}

get_assets :: fn(manager: *AssetManager, ids: []AssetID) -> Optional<[]*Asset> {
	assets := make_slice(temp_arena, ids.count, *Asset);
	for i, id in ids {
		asset, ok := get_asset(manager, id);
		if !ok
			return none([]*Asset);
		assets[i] = asset;
	}
	return wrap(assets);
}

are_assets_done :: fn(manager: *AssetManager) -> bool {
	for i in cast(uint, AssetID.COUNT) {
		if manager.assets[i].base.state == .StartedLoading
			return false;
	}
	return true;
}

load_img :: fn(manager: *AssetManager, name: string, id: AssetID) -> bool {
	if manager.assets[id as uint].base.state != .NotLoaded return false;

	img := &manager.assets[id as uint].img;
	img.t = .Image;
	img.state = .StartedLoading;
	wload_img(name.data, img);
	return true;
}

load_img_on_success :: fn(fname: *u8, img: *ImageAsset, texture: u32, width: u32, height: u32) #foreign #tag="wexport" {
	img.texture = texture;
	img.width   = width;
	img.height  = height;
	img.state   = .Loaded;
	//print("Loaded: %s", fname);
}

load_img_on_error :: fn(fname: *u8, img: *ImageAsset) #foreign #tag="wexport" {
	img.state = .FailedToLoad;
	print("Failed: %s", fname);
}

