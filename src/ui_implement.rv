set_jackbox_style :: fn() {
	elem_color := RGB(31, 41, 55);

	s := get_style(null);
	s.colors.bg_app = darken(RGB(0x0a, 0x14, 0x20));
	s.colors.bg_surface = RGB(0x0a, 0x14, 0x20);
	s.colors.bg_surface_raised = RGB(0x0a, 0x14, 0x20);

	s.colors.text_primary = RGB(245, 247, 247);

	s.colors.accent = elem_color;
	s.colors.accent_hover = lighten(elem_color);
	s.colors.accent_pressed = RGB(0x25, 0x48, 0x68);
	s.colors.accent_disabled = darken(elem_color);

	s.colors.button_bg         = s.colors.accent;
	s.colors.button_bg_hover   = s.colors.accent_hover;
	s.colors.button_bg_pressed = s.colors.accent_pressed;
	s.colors.button_fg         = s.colors.text_primary;

	s.colors.input_bg          = s.colors.accent;
	s.colors.input_border      = RGB(53, 63, 77);
	s.colors.input_border_focus= s.colors.input_border;
	s.colors.input_selection   = RGBA(53, 63, 77, 80);
	s.colors.input_placeholder = RGB(0x8c, 0x93, 0x9c);
}

