module renderer;


khronos_int32_t: type: i32;
khronos_uint32_t: type: u32;
khronos_int64_t: type: i64;
khronos_uint64_t: type: u64;

khronos_int8_t: type: i8;
khronos_uint8_t: type: u8;
khronos_int16_t: type: i16;
khronos_uint16_t: type: u16;
khronos_intptr_t: type: int;
khronos_uintptr_t: type: uint;
khronos_ssize_t: type: int;
khronos_usize_t: type: uint;

khronos_float_t: type: f32;
khronos_utime_nanoseconds_t: type: khronos_uint64_t;
khronos_stime_nanoseconds_t: type: khronos_int64_t;

GLbyte: type: khronos_int8_t;
GLclampf: type: khronos_float_t;
GLfixed: type: khronos_int32_t;
GLshort: type: i16;
GLushort: type: u16;
//struct __GLsync *GLsync;
GLint64: type: khronos_int64_t;
GLuint64: type: khronos_uint64_t;
GLenum: type: u32;
GLuint: type: u32;
GLchar: type: i8;
GLfloat: type : khronos_float_t;
GLsizeiptr: type: khronos_ssize_t;
GLintptr: type: khronos_intptr_t;
GLbitfield: type: u32;
GLint: type: i32;
GLboolean: type: u8;
GLsizei: type: i32;
GLubyte: type: khronos_uint8_t;

glClear :: fn(Mask: GLbitfield) #wasm_import="imports","glClear";
glClearColor :: fn(r: GLfloat, g: GLfloat, b: GLfloat, a: GLfloat) #wasm_import="imports","glClearColor";

glScissor :: fn(x: GLint, y: GLint, width: GLsizei, height: GLsizei) #wasm_import="imports","glScissor";
glLineWidth :: fn(w: GLfloat) #wasm_import="imports","glLineWidth"; 

glViewport  :: fn(x: GLint, y: GLint, width: GLsizei, height: GLsizei) #wasm_import="imports","glViewport";
glClearDepthf  :: fn(d: GLfloat) #wasm_import="imports","glClearDepthf";
glClearStencil  :: fn(s: GLint) #wasm_import="imports","glClearStencil";
glColorMask  :: fn(red: GLboolean, green: GLboolean, blue: GLboolean, alpha: GLboolean) #wasm_import="imports","glColorMask";
glCompileShader  :: fn(shader: GLuint) #wasm_import="imports","glCompileShader";
glCreateProgram  :: fn() -> GLuint #wasm_import="imports","glCreateProgram";
glCullFace  :: fn(mode: GLenum) #wasm_import="imports","glCullFace";
glDeleteBuffers  :: fn(n: GLsizei, buffers: *GLuint) #wasm_import="imports","glDeleteBuffers";
glDeleteFramebuffers  :: fn(n: GLsizei, framebuffers: *GLuint) #wasm_import="imports","glDeleteFramebuffers";
glDeleteProgram  :: fn(program: GLuint) #wasm_import="imports","glDeleteProgram";
glDeleteShader  :: fn(shader: GLuint) #wasm_import="imports","glDeleteShader";
glDepthFunc  :: fn(func: GLenum) #wasm_import="imports","glDepthFunc";
glDepthMask  :: fn(flag: GLboolean) #wasm_import="imports","glDepthMask";
glDepthRangef  :: fn(n: GLfloat, f: GLfloat) #wasm_import="imports","glDepthRangef";
glDetachShader  :: fn(program: GLuint, shader: GLuint) #wasm_import="imports","glDetachShader";
glDisable  :: fn(cap: GLenum) #wasm_import="imports","glDisable";
glDisableVertexAttribArray  :: fn(index: GLuint) #wasm_import="imports","glDisableVertexAttribArray";
glDrawArrays  :: fn(mode: GLenum, first: GLint, count: GLsizei) #wasm_import="imports","glDrawArrays";
glDrawElements  :: fn(mode: GLenum, count: GLsizei, type: GLenum, indices: ?*void) #wasm_import="imports","glDrawElements";
glEnable  :: fn(cap: GLenum) #wasm_import="imports","glEnable";
glBlendFunc :: fn(sfactor: GLenum, dfactor: GLenum) #wasm_import="imports","glBlendFunc";
glEnableVertexAttribArray  :: fn(index: GLuint) #wasm_import="imports","glEnableVertexAttribArray";
glFinish  :: fn() #wasm_import="imports","glFinish";
glFlush  :: fn() #wasm_import="imports","glFlush";

glCreateVertexArray  :: fn() -> u32 #wasm_import="imports","glCreateVertexArray";
glCreateBuffer  :: fn() -> u32 #wasm_import="imports","glCreateBuffer";
glCreateTexture  :: fn() -> u32 #wasm_import="imports","glCreateTexture";
glDeleteTexture  :: fn(texture: GLuint) #wasm_import="imports","glDeleteTexture";

glGetUniformLocation  :: fn(program: GLuint, name: *GLchar) -> GLint #wasm_import="imports","glGetUniformLocation";
glUniform1i  :: fn(location: GLint, v0: GLint) #wasm_import="imports","glUniform1i";
glUniform1f  :: fn(location: GLint, v0: GLfloat) #wasm_import="imports","glUniform1f";
glUniform2f  :: fn(location: GLint, v0: GLfloat, v1: GLfloat) #wasm_import="imports","glUniform2f";
glUniform3f  :: fn(location: GLint, v0: GLfloat, v1: GLfloat, v2: GLfloat) #wasm_import="imports","glUniform3f";
glUniform4f  :: fn(location: GLint, v0: GLfloat, v1: GLfloat, v2: GLfloat, v3: GLfloat) #wasm_import="imports","glUniform4f";
glUniformMatrix4fv :: fn(location: GLint, count: GLsizei, transpose: bool, value: *f32) #wasm_import="imports","glUniformMatrix4fv";
glWebClearUniformBuffer :: fn() #wasm_import="imports","glWebClearUniformBuffer";

glActiveTexture  :: fn(texture: GLenum) #wasm_import="imports","glActiveTexture";
glAttachShader  :: fn(program: GLuint, shader: GLuint) #wasm_import="imports","glAttachShader";
//void glBindAttribLocation (GLuint program, GLuint index, const GLchar *name) WASM_IMPORT(glBindAttribLocation);
glBindBuffer  :: fn(target: GLenum, buffer: GLuint) #wasm_import="imports","glBindBuffer";
glBindVertexArray  :: fn(array: GLuint) #wasm_import="imports","glBindVertexArray";
glBindTexture  :: fn(target: GLenum, texture: GLuint) #wasm_import="imports","glBindTexture";

glBufferData  :: fn(target: GLenum, size: GLsizeiptr, data: *void, usage: GLenum) #wasm_import="imports","glBufferData";
glBufferSubData  :: fn(target: GLenum, offset: GLintptr, size: GLsizeiptr, data: *void) #wasm_import="imports","glBufferSubData";


glTexImage2D  :: fn(target: GLenum, level: GLint, internalformat: GLint, width: GLsizei, height: GLsizei, border: GLint, format: GLenum, type: GLenum, pixels: *void) #wasm_import="imports","glTexImage2D";

glTexParameteri  :: fn(target: GLenum, pname: GLenum, param: GLint) #wasm_import="imports","glTexParameteri";
glGenerateMipmap :: fn(target: GLenum) #wasm_import="imports","glGenerateMipmap";

glVertexAttribPointer  :: fn(index: GLuint, size: GLint, type: GLenum, normalized: GLboolean, stride: GLsizei, pointer: ?*void) #wasm_import="imports","glVertexAttribPointer";

glWebGetShaderCompileStatus  :: fn(shader: GLuint) -> u32 #wasm_import="imports","glWebGetShaderCompileStatus";
glWebGetProgramLinkStatus  :: fn(program: GLuint) -> u32 #wasm_import="imports","glWebGetProgramLinkStatus";

glGetProgramInfoLog  :: fn(program: GLuint, bufSize: GLsizei, length: ?*GLsizei, infoLog: *GLchar) #wasm_import="imports","glGetProgramInfoLog";
glGetShaderInfoLog  :: fn(shader: GLuint, bufSize: GLsizei, length: ?*GLsizei, infoLog: *GLchar) #wasm_import="imports","glGetShaderInfoLog";
glUseProgram  :: fn(program: GLuint) #wasm_import="imports","glUseProgram";
glLinkProgram  :: fn(program: GLuint) #wasm_import="imports","glLinkProgram";

glCreateShader  :: fn(type: GLenum) -> GLuint #wasm_import="imports","glCreateShader";
glWebShaderSource :: fn(shader: GLuint, str: *i8) #wasm_import="imports","glWebShaderSource";

