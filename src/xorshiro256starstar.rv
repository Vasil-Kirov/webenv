/* This is xoshiro256** 1.0, one of our all-purpose, rock-solid
   generators. It has excellent (sub-ns) speed, a state (256 bits) that is
   large enough for any parallel application, and it passes all tests we
   are aware of.

   For generating just floating-point numbers, xoshiro256+ is even faster.

   The state must be seeded so that it is not everywhere zero. If you have
   a 64-bit seed, we suggest to seed a splitmix64 generator and use its
   output to fill s. */

rotl :: fn(x: u64, k: u64) -> u64 #inline {
	return (x << k) | (x >> (64 - k));
}


s: [4]u64;

splitmix64_next :: fn(x: *u64) -> u64 {
	z := (*x += 0x9e3779b97f4a7c15);
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb;
    return z ^ (z >> 31);
}

seed :: fn(seed: u64) {
	sm := seed;

    s[0] = splitmix64_next(&sm);
    s[1] = splitmix64_next(&sm);
    s[2] = splitmix64_next(&sm);
    s[3] = splitmix64_next(&sm);

    /* xoshiro's state must not be all zero */
    if ((s[0] | s[1] | s[2] | s[3]) == 0) {
        s[0] = 0x9e3779b97f4a7c15;
    }
}

next :: fn() -> u64 {
	result := rotl(s[1] * 5, 7) * 9;

	t := s[1] << 17;

	s[2] ^= s[0];
	s[3] ^= s[1];
	s[1] ^= s[2];
	s[0] ^= s[3];

	s[2] ^= t;

	s[3] = rotl(s[3], 45);

	return result;
}

INV_2_53 :: 1.0 / 9007199254740992.0;

next_f64 :: fn() -> f64 {
	return cast(f64, next() >> 11) * INV_2_53;
}

// 0.0 - 1.0
next_f32 :: fn() -> f32 {
	return cast(f32, next() >> 40) / 16777216.0;
}

/* This is the jump function for the generator. It is equivalent
   to 2^128 calls to next(); it can be used to generate 2^128
   non-overlapping subsequences for parallel computations. */

JUMP_LEN :: 4;
jump :: fn() {
	JUMP :: [JUMP_LEN]u64{ 0x180ec6d33cfd0aba, 0xd5a61266f0c9392c, 0xa9582618e03fc9aa, 0x39abdc4529b1661c };

	s0: u64 = 0;
	s1: u64 = 0;
	s2: u64 = 0;
	s3: u64 = 0;
	for i := 0; i < JUMP_LEN; i++
		for b: u64 = 0; b < 64; b++ {
			if (JUMP[i] & (1 << b)) != 0 {
				s0 ^= s[0];
				s1 ^= s[1];
				s2 ^= s[2];
				s3 ^= s[3];
			}
			next();	
		}
		
	s[0] = s0;
	s[1] = s1;
	s[2] = s2;
	s[3] = s3;
}



/* This is the long-jump function for the generator. It is equivalent to
   2^192 calls to next(); it can be used to generate 2^64 starting points,
   from each of which jump() will generate 2^64 non-overlapping
   subsequences for parallel distributed computations. */

long_jump :: fn() {
	LONG_JUMP :: [JUMP_LEN]u64{ 0x76e15d3efefdcbbf, 0xc5004e441c522fb3, 0x77710069854ee241, 0x39109bb02acbe635 };

	s0: u64 = 0;
	s1: u64 = 0;
	s2: u64 = 0;
	s3: u64 = 0;
	for i := 0; i < JUMP_LEN; i++
		for b: u64 = 0; b < 64; b++ {
			if (LONG_JUMP[i] & (1 << b)) != 0 {
				s0 ^= s[0];
				s1 ^= s[1];
				s2 ^= s[2];
				s3 ^= s[3];
			}
			next();	
		}
		
	s[0] = s0;
	s[1] = s1;
	s[2] = s2;
	s[3] = s3;
}



