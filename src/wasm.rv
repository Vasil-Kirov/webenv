	return if i == n then 0 else cast(c_int, *p1 - *p2);
}
*/

memmove :: fn(dest: *void, src: *void, len: int) -> *void #link="memmove" #foreign{
	d := dest as *u8;
	s := src as *u8;
	if d < s {
		for len-- {
			*d = *s;
			d++; s++;
		}
	} else {
		lasts := s + len-1;
		lastd := d + len-1;
		for len-- {
			*lastd = *lasts;
			lastd--;
			lasts--;
		}
	}
	return dest;
}
/*
