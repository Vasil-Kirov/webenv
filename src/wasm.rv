log_n :: fn(s: string, n: int) {
	logs_number(s.data, s.count, n);
}

log_v2 :: fn(s: string, v: v2) {
	logs_floats(s.data, s.count, v[0], v[1]);
}

log :: fn(s: string) {
	logs(s.data, s.count);
}

strlen :: fn(s: *u8) -> int {
	len := 0;
	for s[len] != 0 {
		len++;
	}
	return len;
}

make_u8 :: fn(data: *void, count: int) -> []u8 {
	r: []u8;
	r.data = data;
	r.count = count;
	return r;
}

fmodf :: fn(a: f32, b: f32) -> f32 #foreign {
	q := a / b;
	qi := cast(i32, q);

    return a - cast(f32, qi) * b;
}

bit: fn(u32) -> u32 : n -> 1 << n;

tolower :: fn(c: u32) -> u32 {
	if c >= 'a' return c;
	return c + 32;
}

align_to :: fn(x: $T, align: T) -> T {
	rem := x % align;
	if rem == 0 return x;
	return x + (align - rem);
}

align_pow2 :: fn(address: $T, alignment: T) -> T {
    return ((address + (alignment - 1)) & ~(alignment - 1));
}

if_opt :: fn(o: Optional<$T>, do: fn(T, ?*void), arg: ?*void) {
	if o.ok
		do(o.value, arg);
}

sort :: fn(a: []$T, cmp: fn(T, T) -> int) #nocheck {
	a := a;
	for i in a.count {
		for j := i + 1; j < a.count; ++j {
			if cmp(a[i], a[j]) > 0
				a[i], a[j] = (a[j], a[i]);
		}
	}
}


