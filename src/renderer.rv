module renderer;

#import perf;
#import array;
#import mem;
#import io;
_ :: #import util;
_ :: #import math;
_ :: #import "collections.rv";

MaterialsUBO :: struct #pack {
	diffuse: v3, pad: f32,
	specular: v3, shininess: f32,
}

DirLightUBO :: struct #pack {
	dir: v3, pad0: f32,
	ambient: v3, pad1: f32,
	diffuse: v3, pad2: f32,
	specular: v3, pad3: f32,
}

PointLightUBO :: struct #pack {
	position: v3, constant: f32,
	linear: f32,  quadratic: f32, pad0: f32, pad1: f32,
	ambient: v3,  pad2: f32,
	diffuse: v3,  pad3: f32,
	specular: v3, pad4: f32,
}
LightsUBO :: struct #pack { 
	dir_light: DirLightUBO,
	point_lights: [8]PointLightUBO,
}

UniformParamType :: enum {
	I32,
	F32,
	Vec2,
	Vec3,
	Vec4,
	Mat4,
}

UniformParam :: struct {
	type: UniformParamType,
	name: string,
	u: union {
		i32: i32,
		f32: f32,
		vec2: v2,
		vec3: v3,
		vec4: v4,
		mat4: M4,
	}
}

Material :: struct {
	shader: int,
	material_ubo: Uniformbuffer,
	uniforms: []UniformParam,
	tex: GPUTexture,
	id: int,
}

DrawItem :: struct {
	material: Material,
	mesh: Mesh,
	model: M4,
	flags: u32,
}

Pass :: struct {
	filter: ?*fn(item: DrawItem) -> bool,
	framebuffer: Framebuffer,
	clear: bool,

	is_fullscreen: bool,
	full_screen_material: Material,
	fullscreen_src: GPUTexture,
}

Light :: struct {
	position: v3,
	
	constant: f32,
	linear: f32,
	quadratic: f32,

	ambient: v3,
	diffuse: v3,
	specular: v3,
}

DirLight :: struct {
	dir: v3,

	ambient: v3,
	diffuse: v3,
	specular: v3,
}

Scene :: struct {
	camera: *Camera,
	items: []DrawItem,
}

Batch :: struct {
	items: []DrawItem,
	models: []M4,
	material: Material,
	mesh: Mesh,
}

make_material :: fn(r: *Renderer, shader: int, uniforms: []UniformParam, matubo: Uniformbuffer, tex: GPUTexture) -> Material {
	duped_uniforms, ok := mem.dupe(uniforms, &heap);
	#assert ok;
	return Material {
		shader = shader,
		uniforms = duped_uniforms,
		material_ubo = matubo,
		tex = tex,
		id = r.material_id++,
	};
}


@profile=perf.measure_fn
batch_group_items :: fn(items: *[]DrawItem) -> []Batch {
	batches := array.create(Batch, mem.get_temp());
	for len(*items) != 0 {
		first := (*items)[0];

		batch: Batch;
		batch.items = array.create(DrawItem, mem.get_temp());
		batch.models = array.create(M4, mem.get_temp());
		batch.material = first.material;
		batch.mesh = first.mesh;

		array.add(&batch.models, first.model);
		array.pop(items, 0);
		array.add(&batch.items, first);
		for i := 0; i < len(*items); ++i {
			item := (*items)[i];
			if item.material.id == batch.material.id && item.mesh.id == batch.mesh.id {
				array.pop(items, i);
				array.add(&batch.items, item);
				array.add(&batch.models, item.model);
			}
		}
		array.add(&batches, batch);
	}
	return batches;
}

@profile=perf.measure_fn
draw_scene :: fn(r: *Renderer, passes: []Pass, scene: Scene, lights_ubo: Uniformbuffer) {
	persp, view := calc_vp(r, scene.camera);
	bind_uniform_buffer(lights_ubo);
	set_vp(r, persp, view);

	for pass in passes {
		set_framebuffer(r, pass.framebuffer);
		if pass.clear {
			clear_framebuffer(r);
		}

		if pass.is_fullscreen {
			set_depth_test(false);
			bind_and_draw_fullscreen(r, pass.full_screen_material, pass.fullscreen_src);
			continue;
		}

		pass_filter := pass.filter;
		items := scene.items;
		if pass_filter
			items = filter(scene.items, pass_filter, mem.get_temp());
		if len(items) == 0
			continue;

		set_depth_test(true);
		batches := batch_group_items(&items);
		for batch in batches {
			upload_instanced_data(r, batch.models);
			bind_batch(r, batch);
			pos := resolve_uniform(r.shader, "ViewPos") or { return; };
			set_uniform(pos, scene.camera.position);

			draw_instanced(r, batch.mesh.idx_count, len(batch.items));
		}
	}
}
_ :: #import misc;

