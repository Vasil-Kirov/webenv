module internal

#import wasm;

deref :: fn(pos: *u8) -> u32 {
    p := pos;
    size := str_get_codepoint_size(p);
    return str_extract_codepoint(p, size);
}

print :: fn(buf: *u8, count: int) -> int {
	wasm.logs(buf, count);
	return count;
}

abort :: fn() {
	wasm.abort();
}

str_get_codepoint_size :: fn(codepoint: *u8) -> int {
    p := codepoint;
	SIZE4 :: 0b1111_0000 as u8;
	SIZE3 :: 0b1110_0000 as u8;
	SIZE2 :: 0b1100_0000 as u8;
	if *p & SIZE4 == SIZE4 return 4;
	if *p & SIZE3 == SIZE3 return 3;
	if *p & SIZE2 == SIZE2 return 2;
	return 1;
}

advance :: fn(pos: *u8) -> *u8 {
    size := str_get_codepoint_size(pos);
    p := pos;
    return &p[size];
}

str_extract_codepoint :: fn (p: *u8, size: int) -> u32 {
    res := switch size {
		case 1: {
			yield cast(u32, *p);
		}
		case 2: {
			First := *p & 0b0001_1111;
			Second := *(p+1) & 0b0011_1111;
			yield (First as u32) << 6 | Second as u32;
		}
		case 3: {
			First := *p & 0b0000_1111;
			Second := *(p+1) & 0b0011_1111;
			Third := *(p+2) & 0b0011_1111;
			yield (First as u32) << 12 | (Second as u32) << 6 | Third as u32;
		}
		case 4: {
			First := *p & 0b0000_0111;
			Second := *(p+1) & 0b0011_1111;
			Third := *(p+2) & 0b0011_1111;
			Forth := *(p+3) & 0b0011_1111;
			yield (First as u32) << 18 | (Second as u32) << 12 | (Third as u32) << 6 | Forth as u32;
		}
	};
	return res;
}

